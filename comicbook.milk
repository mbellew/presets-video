comp_1=```
shader_body
{
    // Camera: a window of the page (buffer) mapped to the screen. During BOOTH capture
    // it covers just the active panel (blown up), then pulls back to the whole page.
    // In SPLASH / undecided mode it shows the full frame (the full-frame comic). Page
    // space maps 1:1 to buffer uv and shares the screen aspect, so a single scalar zoom
    // is distortion-free.
    int mode_ = int(floor(q14 + 0.5));
    float2 cc_ = float2(0.5, 0.5);
    float cs_ = 1.0;
    if (mode_ == 1) { cc_ = float2(q9, q10); cs_ = q11; }
    float2 buv = cc_ + (uv - 0.5) * cs_;

    // desk under the page (seen once we pull back past the page edges)
    float3 desk = float3(0.07, 0.06, 0.05);
    float2 dc = uv - 0.5;
    float3 col = desk * (1.0 - dot(dc, dc) * 0.6);

    float inpg = step(0.0, buv.x) * step(buv.x, 1.0) * step(0.0, buv.y) * step(buv.y, 1.0);
    if (inpg > 0.5)
    {
        col = tex2D(sampler_main, buv).xyz;

        // --- CAPTION in the band above the bottom row (cbcaption.png = sampler_fc_cbcaption) ---
        // Fit the phrase to the band HEIGHT and RIGHT-align it, so a long line just leaves space
        // on the left rather than being scaled up to fill the width. Page uv shares the screen
        // aspect, so convert the texture's pixel aspect through texsize to keep the glyphs true.
        float capAR = 14.7217;                    // cbcaption.png width / height
        float2 b0 = float2(0.05, 0.635);          // caption band (page space, y down)
        float2 b1 = float2(0.95, 0.715);
        float As = texsize.x / texsize.y;
        float textH = (b1.y - b0.y) * 0.72;       // leave a little vertical breathing room
        float uW = textH * capAR / As;
        float availW = (b1.x - b0.x) - 0.02;
        if (uW > availW) { uW = availW; textH = uW * As / capAR; }   // clamp if it would overrun
        float xR = b1.x - 0.02;                   // right margin
        float yT = (b0.y + b1.y) * 0.5 - textH * 0.5;
        float2 tuv = (buv - float2(xR - uW, yT)) / float2(uW, textH);
        if (tuv.x > 0.0 && tuv.x < 1.0 && tuv.y > 0.0 && tuv.y < 1.0)
        {
            float cl = dot(tex2D(sampler_fc_cbcaption, tuv).rgb, float3(0.299, 0.587, 0.114));
            float ink = 1.0 - smoothstep(0.35, 0.65, cl);   // dark glyphs -> ink
            col = lerp(col, float3(0.09, 0.08, 0.10), ink);
        }
    }
    else
    {
        // soft drop shadow of the page onto the desk
        float2 dout = max(max(-buv, buv - 1.0), float2(0.0, 0.0));
        float sh = saturate(1.0 - length(dout) * 22.0) * 0.6;
        col = lerp(col, desk * 0.2, sh);
    }

    // capture flash: a clean white pop (no motion lines)
    col = lerp(col, float3(1.0, 1.0, 1.0), q8 * 0.7);

    ret = col;
}
